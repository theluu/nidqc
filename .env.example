# .env.example — NIDQC
#
# Copy thành .env và điền giá trị thật.
# ⛔ KHÔNG BAO GIỜ commit file .env. Xem docs/security/SECURITY_POLICY.md §8.
#
# Lưu ý: môi trường dev dùng DDEV, DDEV tự cấu hình DB — thường KHÔNG cần file này
# cho local. File này dành cho staging/production hoặc cấu hình ngoài DDEV.

# --- Môi trường ---
# development | staging | production
APP_ENV=development

# --- Database ---
DB_HOST=db
DB_PORT=3306
DB_NAME=db
DB_USER=db
DB_PASSWORD=

# --- Drupal ---
# Sinh bằng: openssl rand -hex 32
# Mỗi môi trường một giá trị RIÊNG. Không dùng lại giữa dev và production.
DRUPAL_HASH_SALT=

# Đường dẫn thư mục config đã export
CONFIG_SYNC_DIRECTORY=../config/sync

# --- Site ---
SITE_URL=https://nidqc.ddev.site

# --- Mail (form liên hệ) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# --- Chỉ dùng cho development ---
# ⛔ KHÔNG bật trên production — sẽ lộ stack trace ra ngoài.
DRUPAL_ERROR_LEVEL=verbose
