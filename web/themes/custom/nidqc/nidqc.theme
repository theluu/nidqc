<?php

/**
 * @file
 * Hook của theme NIDQC.
 */

declare(strict_types=1);

/**
 * Implements hook_preprocess_HOOK() for menu--main.
 *
 * Nạp library island CHỈ ở trang có menu chính, không nạp toàn site.
 * Nhét vào library `global` là bắt mọi trang tải JS mà 97,9% nội dung không cần
 * (docs/ROADMAP.md §5, docs/architecture/BACKEND_ARCHITECTURE.md §4).
 */
function nidqc_preprocess_menu__main(array &$variables): void {
  // Không có mục nào thì không cần island — đừng bắt tải JS vô ích.
  if (empty($variables['items'])) {
    return;
  }

  // Menu chỉ có mục phẳng (không submenu) thì mega menu chẳng nâng cấp được gì.
  $has_children = FALSE;
  foreach ($variables['items'] as $item) {
    if (!empty($item['below'])) {
      $has_children = TRUE;
      break;
    }
  }
  if (!$has_children) {
    return;
  }

  $variables['#attached']['library'][] = 'nidqc/islands';
}

/**
 * Implements hook_preprocess_HOOK() for html.
 *
 * Route tài khoản (đăng nhập / khôi phục mật khẩu) -> gắn class body + nạp css/user.css.
 * Chỉ nạp ở đây để trang khác không tải CSS thừa.
 */
function nidqc_preprocess_html(array &$variables): void {
  $route = \Drupal::routeMatch()->getRouteName();
  $auth_routes = [
    'user.login',
    'user.register',
    'user.pass',
    'user.reset',
    'user.reset.login',
    'user.reset.form',
    'entity.user.canonical',
    'entity.user.edit_form',
  ];
  if (in_array($route, $auth_routes, TRUE)) {
    $variables['attributes']['class'][] = 'nidqc-user-auth';
    $variables['#attached']['library'][] = 'nidqc/user';
  }
}

/**
 * Implements hook_preprocess_HOOK() for page.
 *
 * Chuẩn bị dữ liệu ĐỘNG cho trang chủ: tin nổi bật + danh sách tin mới nhất,
 * lấy từ node `news` (biên tập viên sửa node -> trang chủ đổi theo).
 *
 * Chỉ chạy ở trang chủ để không tốn query ở trang khác.
 */
function nidqc_preprocess_page(array &$variables): void {
  $auth_routes = [
    'user.login',
    'user.register',
    'user.pass',
    'user.reset',
    'user.reset.login',
    'user.reset.form',
    'entity.user.canonical',
    'entity.user.edit_form',
  ];
  if (in_array(\Drupal::routeMatch()->getRouteName(), $auth_routes, TRUE)) {
    $variables['page']['breadcrumb'] = [];
  }

  if (empty($variables['is_front'])) {
    return;
  }
  $variables['#attached']['library'][] = 'nidqc/front';

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $view_builder = \Drupal::entityTypeManager()->getViewBuilder('node');
  $alias = \Drupal::service('path_alias.manager');
  $date_formatter = \Drupal::service('date.formatter');

  // 6 tin mới nhất, đã publish. accessCheck để không lộ nội dung chưa duyệt.
  $ids = $storage->getQuery()
    ->condition('type', 'news')
    ->condition('status', 1)
    ->sort('created', 'DESC')
    ->range(0, 6)
    ->accessCheck(TRUE)
    ->execute();

  $items = [];
  foreach ($storage->loadMultiple($ids) as $node) {
    $date = $date_formatter->format($node->getCreatedTime(), 'custom', 'd/m/Y');
    $items[] = [
      'title' => $node->label(),
      'url' => $alias->getAliasByPath('/node/' . $node->id()),
      'date' => $date,
      'tag' => $node->hasField('field_tag') ? $node->get('field_tag')->value : '',
    ];
  }

  // Tin đầu làm "nổi bật", còn lại vào danh sách bên cạnh.
  $variables['nidqc_news_featured'] = $items ? reset($items) : NULL;
  $variables['nidqc_news_list'] = array_slice($items, 1);

  // Liên kết ngoài — design/NIDQC Trang chu.html -> webLinks.
  $variables['nidqc_web_links'] = [
    ['label' => 'Bộ Y Tế', 'url' => 'https://moh.gov.vn'],
    ['label' => 'Cục Quản lý Dược', 'url' => 'https://dav.gov.vn'],
    ['label' => 'Viện Kiểm nghiệm thuốc TP. Hồ Chí Minh', 'url' => '#'],
    ['label' => 'Tổ chức Y tế Thế giới (WHO)', 'url' => 'https://www.who.int'],
  ];
}
