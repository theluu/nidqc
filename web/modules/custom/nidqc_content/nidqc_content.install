<?php

/**
 * @file
 * Cài đặt module NIDQC Content.
 *
 * VÌ SAO CÓ FILE NÀY:
 *
 * Taxonomy term là entity CONTENT, không phải configuration. `drush cex` KHÔNG
 * export chúng. Nên sau khi `drush si` + `drush cim` trên máy mới, content type
 * và pathauto pattern dựng lại đủ, nhưng chuyên mục tin tức / nhóm văn bản /
 * nhóm câu hỏi thì RỖNG — kiểm chứng 2026-07-16.
 *
 * Đây là cùng một lỗ hổng với menu link (ROADMAP.md nợ kỹ thuật #10): config/sync
 * lo được config, không lo được content.
 *
 * hook_install() giải bài này cho taxonomy: term trở thành CODE, vào git, chạy
 * lại được trên mọi môi trường.
 *
 * ⚠️ Term ở đây lấy NGUYÊN VĂN từ design đã duyệt (design/NIDQC Tin tuc danh
 * sach.html: catDefs; Van ban tai lieu.html: tabDefs; FAQ.html: rawGroups).
 * Đổi term = đổi thứ NIDQC đã duyệt -> phải qua change request, không sửa lén.
 *
 * ⚠️ hook_install() chỉ chạy MỘT LẦN lúc cài module. Thêm/sửa term sau này phải
 * viết hook_update_N().
 */

declare(strict_types=1);

use Drupal\menu_link_content\Entity\MenuLinkContent;
use Drupal\taxonomy\Entity\Term;

/**
 * Term lấy nguyên văn từ design đã duyệt.
 *
 * 'Tất cả' trong design KHÔNG phải term — nó là bộ lọc trên giao diện.
 */
function nidqc_content_default_terms(): array {
  return [
    // design/NIDQC Tin tuc danh sach.html -> catDefs
    'news_category' => [
      'Thông báo',
      'Tin hoạt động',
      'Mua sắm - đấu thầu',
      'Đào tạo',
      'Hội nghị - Hội thảo',
      'Tuyển dụng',
    ],
    // design/NIDQC Van ban tai lieu.html -> tabDefs
    'document_group' => [
      'Văn bản pháp quy',
      'Tài liệu chuyên môn',
    ],
    // design/NIDQC FAQ.html -> rawGroups (đủ 3 nhóm — bản đầu chỉ có 1, thiếu 2)
    'faq_group' => [
      'Dịch vụ kiểm nghiệm',
      'Chất chuẩn - chất đối chiếu',
      'Văn bản - tài liệu',
    ],
  ];
}


/**
 * Menu chính — lấy nguyên văn từ design đã duyệt.
 *
 * Nguồn: design/NIDQC FAQ.html -> const NAV (giống nhau ở cả 11 trang).
 *
 * Ánh xạ href của design sang route thật theo docs/design/PAGE_MAPPING.md §1:
 *   NIDQC-Homepage.dc.html   -> /
 *   Gioi-thieu-chung.dc.html -> /gioi-thieu-chung   (v.v.)
 *
 * Menu link là entity CONTENT -> `drush cex` KHÔNG export. Đó là lý do chúng nằm
 * đây thay vì trong config/install. Xem ROADMAP.md nợ #10.
 */
function nidqc_content_default_menu(): array {
  return [
    ['Trang chủ', 'internal:/', []],
    ['Giới thiệu', 'internal:/gioi-thieu-chung', [
      ['Giới thiệu chung', 'internal:/gioi-thieu-chung'],
      ['Chính sách chất lượng', 'internal:/chinh-sach-chat-luong'],
      ['Năng lực', 'internal:/nang-luc'],
      ['Cơ cấu tổ chức', 'internal:/co-cau-to-chuc'],
    ]],
    ['Hoạt động chuyên môn', 'internal:/#hoat-dong-chuyen-mon', [
      ['Chỉ đạo tuyến', 'internal:/#chi-dao-tuyen'],
      ['Kiểm nghiệm và giám sát chất lượng thuốc', 'internal:/#kiem-nghiem-giam-sat-chat-luong-thuoc'],
      ['Hợp tác quốc tế', 'internal:/#hop-tac-quoc-te'],
      ['Hoạt động NRA', 'internal:/#hoat-dong-nra'],
      ['Tạp chí Kiểm nghiệm Dược và Mỹ phẩm', 'internal:/#tap-chi-kiem-nghiem'],
    ]],
    // Design để href='#' cho nhóm này (placeholder), nhưng trang Dao tao NCKH CÓ
    // trong bộ design -> trỏ vào trang thật. Ghi ở TASK-008 §9.
    ['Đào tạo & NCKH', 'internal:/dao-tao-nckh', [
      ['Đào tạo tiến sỹ', 'internal:/dao-tao-nckh#dao-tao-tien-sy'],
      ['Nghiên cứu khoa học', 'internal:/dao-tao-nckh#nghien-cuu-khoa-hoc'],
    ]],
    ['Dịch vụ', 'internal:/#dich-vu', [
      ['Phân tích - Kiểm nghiệm', 'internal:/#dich-vu'],
      ['Đánh giá tương đương sinh học (TĐSH)', 'internal:/#dich-vu'],
      ['Đào tạo và tư vấn kỹ thuật', 'internal:/#dich-vu'],
      ['Hiệu chuẩn', 'internal:/#dich-vu'],
      ['Nghiên cứu - Chuyển giao', 'internal:/#dich-vu'],
      ['Thử nghiệm thành thạo', 'internal:/#dich-vu'],
      ['Cung ứng chất chuẩn', 'internal:/#chat-chuan'],
    ]],
    // Design trỏ cả 6 mục con vào cùng trang danh sách; bộ lọc chạy phía client.
    // Dùng ?cat= để mỗi mục lọc đúng chuyên mục VÀ Google index được từng mục.
    ['Tin tức & Thông báo', 'internal:/tin-tuc', [
      ['Thông báo', 'internal:/tin-tuc?cat=thong-bao'],
      ['Tin hoạt động', 'internal:/tin-tuc?cat=tin-hoat-dong'],
      ['Mua sắm, đấu thầu & công khai minh bạch', 'internal:/tin-tuc?cat=mua-sam-dau-thau'],
      ['Đào tạo', 'internal:/tin-tuc?cat=dao-tao'],
      ['Hội nghị - Hội thảo', 'internal:/tin-tuc?cat=hoi-nghi-hoi-thao'],
      ['Tuyển dụng', 'internal:/tin-tuc?cat=tuyen-dung'],
    ]],
    ['Văn bản - Tài liệu', 'internal:/van-ban-tai-lieu', [
      ['Văn bản pháp quy', 'internal:/van-ban-tai-lieu?nhom=van-ban-phap-quy'],
      ['Tài liệu chuyên môn', 'internal:/van-ban-tai-lieu?nhom=tai-lieu-chuyen-mon'],
    ]],
    ['Liên hệ & hỗ trợ', 'internal:/lien-he', [
      ['Liên hệ', 'internal:/lien-he'],
      ['Câu hỏi thường gặp', 'internal:/faq'],
    ]],
  ];
}

/**
 * Tạo menu chính. Idempotent.
 */
function _nidqc_content_create_menu(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('menu_link_content');
  foreach (nidqc_content_default_menu() as $weight => [$title, $uri, $children]) {
    $existing = $storage->loadByProperties(['menu_name' => 'main', 'title' => $title]);
    $parent = $existing ? reset($existing) : MenuLinkContent::create([
      'title' => $title,
      'link' => ['uri' => $uri],
      'menu_name' => 'main',
      'weight' => $weight,
      'expanded' => TRUE,
    ]);
    $parent->set('link', ['uri' => $uri]);
    $parent->set('weight', $weight);
    $parent->set('expanded', TRUE);
    $parent->save();
    foreach ($children as $cw => [$ctitle, $curi]) {
      $childExisting = $storage->loadByProperties(['menu_name' => 'main', 'title' => $ctitle]);
      $child = $childExisting ? reset($childExisting) : MenuLinkContent::create([
        'title' => $ctitle,
        'menu_name' => 'main',
      ]);
      $child->set('link', ['uri' => $curi]);
      $child->set('parent', 'menu_link_content:' . $parent->uuid());
      $child->set('weight', $cw);
      $child->save();
    }
  }
}

/**
 * Implements hook_install().
 */
function nidqc_content_install(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');

  foreach (nidqc_content_default_terms() as $vid => $names) {
    foreach ($names as $weight => $name) {
      // Idempotent: cài lại module không tạo term trùng.
      $existing = $storage->loadByProperties(['vid' => $vid, 'name' => $name]);
      if ($existing) {
        continue;
      }
      Term::create([
        'vid' => $vid,
        'name' => $name,
        'weight' => $weight,
      ])->save();
    }
  }

  _nidqc_content_create_menu();
}

/**
 * Implements hook_uninstall().
 *
 * Config có `enforced` dependency nên Drupal tự dọn. Term là content nên phải
 * tự xoá, nếu không gỡ rồi cài lại sẽ để lại term mồ côi trỏ vào vocabulary
 * đã bị xoá.
 */
function nidqc_content_uninstall(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  foreach (array_keys(nidqc_content_default_terms()) as $vid) {
    $terms = $storage->loadByProperties(['vid' => $vid]);
    if ($terms) {
      $storage->delete($terms);
    }
  }

  // Menu link cũng là content -> phải tự dọn.
  $links = \Drupal::entityTypeManager()->getStorage('menu_link_content')
    ->loadByProperties(['menu_name' => 'main']);
  if ($links) {
    \Drupal::entityTypeManager()->getStorage('menu_link_content')->delete($links);
  }
}

/**
 * Copies the legacy news date into core created and refreshes menu destinations.
 */
function nidqc_content_update_11001(): void {
  $database = \Drupal::database();
  if ($database->schema()->tableExists('node__field_date')) {
    $rows = $database->select('node__field_date', 'd')
      ->fields('d', ['entity_id', 'langcode', 'field_date_value'])
      ->condition('deleted', 0)
      ->execute();
    foreach ($rows as $row) {
      $timestamp = strtotime($row->field_date_value . ' 12:00:00');
      if ($timestamp === FALSE) {
        continue;
      }
      $database->update('node_field_data')
        ->fields(['created' => $timestamp])
        ->condition('nid', $row->entity_id)
        ->condition('langcode', $row->langcode)
        ->execute();
    }
  }

  _nidqc_content_create_menu();
}

/**
 * Removes the retired Tra cứu menu link.
 */
function nidqc_content_update_11002(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('menu_link_content');
  $links = $storage->loadByProperties([
    'menu_name' => 'main',
    'title' => 'Tra cứu',
  ]);
  if ($links) {
    $storage->delete($links);
  }
}
