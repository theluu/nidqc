                        "value": "Văn bản pháp quy và tài liệu chuyên môn là hệ thống nội bộ, chỉ hiển thị đầy đủ cho cán bộ, viên chức đã đăng nhập bằng tài khoản được cấp.",
                        "format": "basic_html"
                    }
                ]
            },
            "field_group": {
                "__ref__": "taxonomy_term",
                "names": [
                    "Văn bản - tài liệu"
                ]
            }
        }
    },
